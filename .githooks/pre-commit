#!/bin/sh
git diff --cached --quiet --no-ext-diff -- rules/CLAUDE.global.md ':(top,glob)rules/personal/*.md' scripts/compose-rules.py
case $? in
    0) exit 0 ;;
    1) ;;
    *) echo 'pre-commit: git diff failed' >&2; exit 1 ;;
esac
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) exec python -X utf8 scripts/rules-hook.py ;;
    *) exec python3 -X utf8 scripts/rules-hook.py ;;
esac
